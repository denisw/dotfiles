// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "title_bar": {
    "show_sign_in": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "diff_view_style": "unified",
  "git_panel": {
    "group_by": "staging",
    "dock": "left",
    "tree_view": true,
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
  },
  "tab_bar": {
    "show": true,
  },
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "Catppuccin Mocha",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 12.0,
  "ui_font_size": 14.0,
  "wrap_guides": [80],
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
    "use_smartcase_find": true,
  },
  "tab_size": 2,
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": true,
  },
  "edit_predictions": {
    "provider": "none",
    "mode": "subtle",
  },
  "terminal": {
    "option_as_meta": true,
    "detect_venv": {
      "on": {
        "activate_script": "fish",
      },
    },
  },
  "file_types": {
    "Helm": [
      "**/charts/**/templates/*.tpl",
      "**/charts/**/templates/*.yaml",
      "**/charts/**/templates/*.yml",
    ],
  },
  "languages": {
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
      "format_on_save": "on",
    },
    "Java": {
      "tab_size": 4,
    },
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "node_modules/.bin/prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "HTML": {
      "format_on_save": "off",
    },
    "PHP": {
      "tab_size": 4,
    },
    "Markdown": {
      "preferred_line_length": 80,
      "soft_wrap": "bounded",
    },
    "Python": {
      "tab_size": 4,
      "wrap_guides": [88],
      "format_on_save": "on",
      "language_servers": [
        "ty",
        "ruff",
        "!basedpyright",
        "!pyrefly",
        "!pyright",
        "!pylsp",
      ],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop", "!solargraph"],
    },
    "Rust": {
      "tab_size": 4,
      "format_on_save": "on",
      "wrap_guides": [100],
    },
    "Terraform": {
      "format_on_save": "on",
    },
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "node_modules/.bin/prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TOML": {
      "tab_size": 4,
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "rust-analyzer": {
      "initialization_options": {
        "imports": {
          "granularity": {
            "group": "module",
          },
        },
      },
    },
  },
}
