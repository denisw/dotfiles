###########################################################################
# Basics
###########################################################################

# Agents
brew "opencode"
cask "copilot-cli"

# Containers
brew "colima"
brew "docker"
brew "docker-buildx"
brew "docker-compose"

# Editors
brew "neovim"
brew "tree-sitter-cli"
brew "vim"

# Fonts
cask "font-fira-code"
cask "font-fira-code-nerd-font"
cask "font-hack"
cask "font-hack-nerd-font"
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"
cask "font-symbols-only-nerd-font"

# Git
brew "git"
brew "lazygit"

# Shells & Terminals
brew "bash"
brew "fish"
brew "zsh"
cask "ghostty"
cask "wezterm@nightly"

# Tools
brew "direnv"
brew "fd"
brew "fzf"
brew "gh"
brew "jq"
brew "make"
brew "mise"
brew "rclone"
brew "ripgrep"
brew "stow"
brew "watch"
brew "watchman"
cask "hammerspoon"

###########################################################################
