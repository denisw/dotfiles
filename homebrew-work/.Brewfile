brew "maven"
cask "temurin@25"

# PHP
brew "composer"
brew "coreutils"
brew "php"

# Node.js
brew "node"

# Python
brew "pipx"
brew "python@3.14"
brew "uv"

# Shell
brew "shellcheck"

# Terraform / OpenTofu
